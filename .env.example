# ==============================================================
# ONLINE MCQ EXAM & QUIZ PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================

# Supabase Configuration (PostgreSQL + Auth/RLS)
# Replace these with your actual Supabase project keys from your Supabase Dashboard
# Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Admin Authentication
# Used to authenticate Admin access to /admin dashboard
ADMIN_SECRET_KEY=your-secure-admin-password

# Application Branding
NEXT_PUBLIC_APP_NAME=TESTPREP